{
  "expo": {
    "name": "MomoStory",
    "slug": "momostory",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "momostory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "icon": "./public/icon-512.png",
    "android": {
      "package": "com.momostory.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-512.png",
        "backgroundColor": "#FB94A7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
